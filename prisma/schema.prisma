// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// GLOBAL SETTINGS 
// -----------------------------------------------------------------------------

model SiteConfig {
  id                     Int      @id @default(1)
  companyName            String
  legalName              String
  logoUrl                String?
  uploadedLogoUrl        String?
  contactEmail           String
  contactPhone           String
  whatsappNumber         String
  addressText            String
  businessHours          String
  footerDescription      String
  googleMapsIframeUrl    String?
  urlLinkedin            String?
  urlYoutube             String?
  urlInstagram           String?
  seoDefaultTitle        String
  seoDefaultDescription  String
  sectionVisibility      Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// ORGANIZATION LOGOS (Marquees/Brands/Universities)
// -----------------------------------------------------------------------------

enum LogoPlacement {
  CLIENT
  BRAND
  UNIVERSITY
  PARTNER
}

model OrganizationLogo {
  id             String        @id @default(uuid())
  name           String
  logoUrl        String?
  category       String
  placementType  LogoPlacement
  pageScope      String        @default("GLOBAL") // Ensures Home scope isolation
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)
  showTextOnCard Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// -----------------------------------------------------------------------------
// DIGITAL SOLUTIONS & ACADEMICS
// -----------------------------------------------------------------------------

model Product {
  id             String   @id @default(uuid())
  name           String
  marketingTitle String
  badgeText      String?
  description    String
  productUrl     String?
  ctaText        String?
  tags           Json // Array of tags
  features       Json // Array of feature objects
  isFeatured     Boolean  @default(false)
  screenshotUrl  String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ClientProject {
  id             String   @id @default(uuid())
  title          String
  industry       String
  description    String
  status         String?
  isConfidential Boolean  @default(false)
  isFeatured     Boolean  @default(false)
  tags           Json
  imageUrl       String?
  projectUrl     String?
  caseStudy      String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StudentProject {
  id          String   @id @default(uuid())
  title       String
  category    String
  badge       String?
  description String
  isFeatured  Boolean  @default(false)
  imageUrl    String?
  projectUrl  String?
  tags        Json
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Happimonial {
  id           String   @id @default(uuid())
  clientName   String
  companyName  String
  industry     String
  testimonial  String
  isFeatured   Boolean  @default(false)
  videoUrl     String?
  thumbnailUrl String?
  youtubeUrl   String? // Optional YouTube URL; one-video-HOME rule enforced at API level
  pageScope    String   @default("GLOBAL") // Ensures Home scope isolation
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StudentImpact {
  id            String   @id @default(uuid())
  studentName   String
  designation   String
  quote         String
  academicRoute String
  videoUrl      String?
  youtubeUrl    String?
  isFeatured    Boolean  @default(false)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// LEADS (CRM Inbox)
// -----------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  SPAM
}

model Lead {
  id              String     @id @default(uuid())
  fullName        String
  email           String
  phone           String
  company         String?
  serviceInterest String
  message         String
  status          LeadStatus @default(NEW)
  internalNotes   String?
  source          String?
  sourcePage      String?
  landingPage     String?
  referrer        String?
  isArchived      Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// -----------------------------------------------------------------------------
// VISITORS & MEDIA
// -----------------------------------------------------------------------------

model Visitor {
  id              String   @id @default(uuid())
  sessionId       String
  ipAddress       String?
  userAgent       String?
  country         String?
  city            String?
  deviceType      String?
  browser         String?
  operatingSystem String?
  landingPage     String?
  referrerUrl     String?
  pageVisits      Json?    // Array of {path: string, timestamp: DateTime}
  firstVisitedAt  DateTime @default(now())
  lastVisitedAt   DateTime @default(now())
  pageViews       Int      @default(1)
  isBot           Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sessionId])
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

model Media {
  id         String    @id @default(uuid())
  fileName   String
  fileUrl    String
  mimeType   String
  fileSize   Int?
  mediaType  MediaType
  altText    String?
  uploadedBy String?
  pageScope  String    @default("GLOBAL") // Ensures Home scope isolation
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// ADMIN & AUTHENTICATION
// -----------------------------------------------------------------------------

model AdminUser {
  id                  String    @id @default(uuid())
  username            String    @unique
  email               String    @unique
  passwordHash        String
  fullName            String
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockUntil           DateTime?

  activityLogs AdminActivityLog[]
}

model AdminActivityLog {
  id          String   @id @default(uuid())
  adminUserId String
  action      String
  entity      String
  entityId    String?
  description String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
}

// -----------------------------------------------------------------------------
// BLOGS & ACTIVITY UPDATES (Ecosystem, Visits, Partnerships, Events)
// -----------------------------------------------------------------------------

enum ActivityType {
  GOVERNMENT_OFFICIAL
  PARTNERSHIP
  INDUSTRY_VISIT
  MEETING
  EVENT
  ACHIEVEMENT
  FOUNDER_ACTIVITY
  WEBINAR
  ANNOUNCEMENT
  COMMUNITY
}

model ActivityPost {
  id           String        @id @default(uuid())
  title        String
  slug         String        @unique
  activityType ActivityType  @default(MEETING)
  summary      String
  content      String?
  images       Json          // Array of up to 5 image objects [{ url: string, altText?: string, caption?: string }]
  location     String?
  activityDate DateTime      @default(now())
  externalLink String?       // e.g. LinkedIn post URL
  isFeatured   Boolean       @default(false)
  showOnHome   Boolean       @default(true)
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([activityType])
  @@index([activityDate])
}

// -----------------------------------------------------------------------------
// CAREERS & JOB VACANCIES
// -----------------------------------------------------------------------------

model Career {
  id              String    @id @default(uuid())
  title           String
  department      String    // Digital Solutions, Products, Academics, Operations
  employmentType  String    // Full-Time, Part-Time, Internship, Contract
  location        String    @default("Tirunelveli, Tamil Nadu (Onsite / Hybrid)")
  experienceLevel String    // Fresher / 0-1 Yr, 1-3 Yrs, 3-5+ Yrs
  salaryRange     String?   // e.g. "₹4.5L - ₹7.5L / year" or "Paid Stipend"
  description     String    @db.Text
  responsibilities Json     // Array of strings
  requirements    Json      // Array of strings
  skills          Json      // Array of strings (chips)
  badgeText       String?   // e.g. "Urgent", "Featured"
  applyLink       String?   // Custom external application link
  applyEmail      String?   @default("careers@ss40network.com")
  isFeatured      Boolean   @default(false)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  applications    JobApplication[]

  @@index([department])
  @@index([isActive])
}

// -----------------------------------------------------------------------------
// JOB APPLICATIONS
// -----------------------------------------------------------------------------

model JobApplication {
  id              String   @id @default(uuid())
  careerId        String?
  roleTitle       String
  department      String?
  fullName        String
  email           String
  phone           String
  experienceLevel String?
  currentOrg      String?
  portfolioUrl    String?
  linkedinUrl     String?
  resumeUrl       String?
  coverLetter     String?  @db.Text
  status          String   @default("PENDING") // PENDING, REVIEWED, SHORTLISTED, REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  career Career? @relation(fields: [careerId], references: [id], onDelete: SetNull)

  @@index([roleTitle])
  @@index([status])
}

